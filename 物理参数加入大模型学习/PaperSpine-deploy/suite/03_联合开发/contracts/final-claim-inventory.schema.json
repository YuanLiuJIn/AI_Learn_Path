{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/final-claim-inventory.schema.json",
  "title": "Independent final-reader claim inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "subject", "producer", "manuscript_sha256", "source_claim_graph_sha256", "scope_receipt", "required_surfaces", "registered_claims", "reader_inventory", "surface_receipts", "extraction_receipt"],
  "properties": {
    "contract": {"const": "paperspine5.final-claim-inventory"},
    "subject": {"type": "object"},
    "producer": {"type": "object"},
    "manuscript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_claim_graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_receipt": {"type": "object"},
    "required_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["title", "abstract", "conclusion", "caption", "body"]}},
    "registered_claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["claim_id", "disposition", "reader_facing_expected", "evidence_ids"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["retained", "omitted"]},
          "reader_facing_expected": {"type": "boolean"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "reader_inventory": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "surface_receipts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "extraction_receipt": {"type": "object"}
  }
}
