   "source": [
    "```\n",
    "# 找到第一个命中 GT bbox 的点的排名 k (1-based)\n",
    "if 命中: accuracy = 1 / sqrt(num_pred * k)     # 越少猜、越早中 → 分越高\n",
    "else:    accuracy = -1 / num_pred              # 猜得多 → 失败惩罚越轻\n",
    "score = 1.0*format + 1.0*accuracy              # 值域 [-1, 1], 零中心\n",
    "```"
   ]
  }
 ],
