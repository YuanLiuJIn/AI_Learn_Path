{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine5.local/release/skill-managed-suite-reconciliation-receipt.schema.json",
  "title": "PaperSpine5 standalone Skill managed-suite runtime residue reconciliation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schema_version", "operation_id", "request_sha256", "status",
    "created_at", "source_root", "cache_root", "source_build_id",
    "source_content_index_sha256", "source_validation", "files", "file_count",
    "total_bytes", "path_digest_sha256", "post_cache_classification",
    "external_action_authorized", "self_sha256"
  ],
  "properties": {
    "contract": {"const": "paperspine5.skill-managed-suite-reconciliation-receipt"},
    "schema_version": {"const": "1.0"},
    "operation_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "committed"},
    "created_at": {"type": "string", "minLength": 1},
    "source_root": {"type": "string", "minLength": 1},
    "cache_root": {"type": "string", "minLength": 1},
    "source_build_id": {"type": "string", "minLength": 1},
    "source_content_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "schema_version", "mode", "build_id",
        "content_index_sha256", "target_root", "projection_root",
        "projection_tree", "initial_suite_tree", "initial_classification",
        "runtime_residue", "runtime_residue_summary", "candidate_verified",
        "candidate_eligible", "external_action_authorized", "self_sha256"
      ],
      "properties": {
        "contract": {"const": "paperspine5.skill-managed-suite-prestate-validation"},
        "schema_version": {"const": "1.0"},
        "mode": {"const": "managed-suite"},
        "build_id": {"type": "string", "minLength": 1},
        "content_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_root": {"type": "string", "minLength": 1},
        "projection_root": {"type": "string", "minLength": 1},
        "projection_tree": {"type": "object"},
        "initial_suite_tree": {"type": "object"},
        "initial_classification": {"const": "runtime-residue"},
        "runtime_residue": {"type": "array", "minItems": 1},
        "runtime_residue_summary": {"$ref": "#/$defs/residueSummary"},
        "candidate_verified": {"type": "boolean"},
        "candidate_eligible": {"const": true},
        "external_action_authorized": {"const": false},
        "self_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/residueFile"}
    },
    "file_count": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 16},
    "path_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_cache_classification": {"const": "clean"},
    "external_action_authorized": {"const": false},
    "self_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "residueSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_bytes", "path_digest_sha256"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 16},
        "path_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "residueFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "source_path", "source_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "(^|/)__pycache__/[^/]+\\.pyc$"},
        "size_bytes": {"type": "integer", "minimum": 16},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_path": {"type": "string", "pattern": "\\.py$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
