    "controller_sha256": {"$ref": "#/$defs/sha"}, "profile_adapter_sha256": {"$ref": "#/$defs/sha"}, "host_adapter_sha256": {"$ref": "#/$defs/sha"}, "evaluator_adapter_sha256": {"$ref": "#/$defs/sha"},
    "profile_schema_sha256": {"$ref": "#/$defs/sha"}, "recovery_install_schema_sha256": {"$ref": "#/$defs/sha"},
    "result_schema_sha256": {"$ref": "#/$defs/sha"}, "index_schema_sha256": {"$ref": "#/$defs/sha"}, "aggregate_schema_sha256": {"$ref": "#/$defs/sha"},
    "run_count": {"const": 42},
    "runs": {"type": "array", "minItems": 42, "maxItems": 42, "items": {"type": "object", "additionalProperties": false, "required": ["run_id", "sample_id", "entry_mode", "attempt", "relative_path", "file_sha256", "receipt_sha256", "status"], "properties": {"run_id": {"type": "string", "minLength": 1}, "sample_id": {"type": "string", "minLength": 1}, "entry_mode": {"enum": ["natural_language", "explicit_paper_spine"]}, "attempt": {"enum": [1, 2]}, "relative_path": {"type": "string", "minLength": 1}, "file_sha256": {"$ref": "#/$defs/sha"}, "receipt_sha256": {"$ref": "#/$defs/sha"}, "status": {"enum": ["PASS", "FAIL"]}}}},
    "created_at": {"type": "string", "format": "date-time"}, "product_runs_executed": {"const": 42}, "evaluator_results_created": {"const": 42}, "external_action_authorized": {"const": false}, "index_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
