{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/assembly-manifest.schema.json",
  "title": "PaperFigure assembly evidence",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "job_id", "paper_id", "figures", "dispositions", "figure_includes", "supplementary_figure_includes", "figure_disposition_manifest", "main_tex_updated", "body_contract", "body_contract_markdown", "figure_asset_map"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "PASS"},
    "job_id": {"type": "string"},
    "paper_id": {"type": "string"},
    "figures": {"type": "array", "minItems": 0, "items": {"type": "object", "required": ["figure_id", "candidate_id", "format", "destination", "sha256", "caption", "label", "editable_source", "selection_evidence"], "properties": {"figure_id": {"type": "string"}, "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "format": {"enum": ["pdf", "svg", "png"]}, "destination": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "caption": {"type": "string"}, "label": {"type": "string"}, "editable_source": {"type": ["object", "null"]}, "selection_evidence": {"type": "object"}}, "additionalProperties": true}},
    "dispositions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "figure_includes": {"type": "string"},
    "supplementary_figure_includes": {"type": ["string", "null"]},
    "figure_disposition_manifest": {"type": "string"},
    "main_tex_updated": {"type": "boolean"},
    "body_contract": {"type": "string"},
    "body_contract_markdown": {"type": "string"},
    "figure_asset_map": {"type": "string"}
    ,"identity_completion_receipt": {"type": ["string", "null"]}
  }
}
