{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine5.local/contracts/maturity-evaluator-receipt-v3.schema.json",
  "title": "Independent maturity evaluator receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "contract_version", "run_id", "sample_id", "entry_mode", "attempt",
    "protocol_file_sha256", "protocol_sha256", "predecessor_protocol_file_sha256",
    "predecessor_protocol_sha256", "fixture_receipt_file_sha256", "fixture_receipt_sha256",
    "producer_identity", "evaluator_identity", "evaluator_code_sha256",
    "evaluator_schema_sha256", "protocol_validator_sha256", "protocol_schema_sha256",
    "fixture_receipt_schema_sha256", "fixture_index_schema_sha256",
    "target_review_schema_sha256", "canonical_surface_adapter_sha256",
    "surface_receipt_schema_sha256", "target_profile_catalog_sha256", "evaluated_at",
    "subject", "evidence", "hard_checks", "status", "external_action_authorized",
    "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "paperspine5.maturity-independent-evaluation-v3"},
    "contract_version": {"const": "3.0"},
    "run_id": {"type": "string", "pattern": "^psgap014-v3\\.[a-z0-9_-]+\\.(natural_language|explicit_paper_spine)\\.a(01|02)$"},
    "sample_id": {"type": "string", "minLength": 1},
    "entry_mode": {"enum": ["natural_language", "explicit_paper_spine"]},
    "attempt": {"enum": [1, 2]},
    "protocol_file_sha256": {"$ref": "#/$defs/sha"},
    "protocol_sha256": {"$ref": "#/$defs/sha"},
    "predecessor_protocol_file_sha256": {"$ref": "#/$defs/sha"},
    "predecessor_protocol_sha256": {"$ref": "#/$defs/sha"},
    "fixture_receipt_file_sha256": {"$ref": "#/$defs/sha"},
    "fixture_receipt_sha256": {"$ref": "#/$defs/sha"},
    "producer_identity": {"type": "string", "minLength": 1},
    "evaluator_identity": {"const": "paperspine5-independent-maturity-evaluator-v3"},
    "evaluator_code_sha256": {"$ref": "#/$defs/sha"},
    "evaluator_schema_sha256": {"$ref": "#/$defs/sha"},
    "protocol_validator_sha256": {"$ref": "#/$defs/sha"},
    "protocol_schema_sha256": {"$ref": "#/$defs/sha"},
    "fixture_receipt_schema_sha256": {"$ref": "#/$defs/sha"},
    "fixture_index_schema_sha256": {"$ref": "#/$defs/sha"},
    "target_review_schema_sha256": {"$ref": "#/$defs/sha"},
    "canonical_surface_adapter_sha256": {"$ref": "#/$defs/sha"},
    "surface_receipt_schema_sha256": {"$ref": "#/$defs/sha"},
    "target_profile_catalog_sha256": {"$ref": "#/$defs/sha"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "subject": {"$ref": "#/$defs/subject"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_snapshot", "artifact_ledger", "package_manifest", "pdf", "docx",
        "render_receipt", "citation_receipt", "target_review_receipt",
        "readiness_receipt", "recovery_or_install_receipt", "pdf_figure_receipt",
        "fixture_freeze_receipt", "bibliography_source_receipt"
      ],
      "properties": {
        "task_snapshot": {"$ref": "#/$defs/evidenceRef"},
        "artifact_ledger": {"$ref": "#/$defs/evidenceRef"},
        "package_manifest": {"$ref": "#/$defs/evidenceRef"},
        "pdf": {"$ref": "#/$defs/evidenceRef"},
        "docx": {"$ref": "#/$defs/evidenceRef"},
        "render_receipt": {"$ref": "#/$defs/evidenceRef"},
        "citation_receipt": {"$ref": "#/$defs/evidenceRef"},
        "target_review_receipt": {"$ref": "#/$defs/evidenceRef"},
        "readiness_receipt": {"$ref": "#/$defs/evidenceRef"},
        "figure_identity_receipt": {"$ref": "#/$defs/evidenceRef"},
        "recovery_or_install_receipt": {"$ref": "#/$defs/evidenceRef"},
        "pdf_figure_receipt": {"$ref": "#/$defs/evidenceRef"},
        "fixture_freeze_receipt": {"$ref": "#/$defs/evidenceRef"},
        "bibliography_source_receipt": {"$ref": "#/$defs/evidenceRef"}
      }
    },
    "hard_checks": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["PASS", "FAIL"]}},
    "status": {"enum": ["PASS", "FAIL"]},
    "external_action_authorized": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "revision_id", "build_id", "material_snapshot_sha256"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "pattern": "^[0-9]+$"},
        "build_id": {"type": "string", "minLength": 1},
        "material_snapshot_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "path", "sha256", "subject"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "subject": {"$ref": "#/$defs/subject"}
      }
    }
  }
}
