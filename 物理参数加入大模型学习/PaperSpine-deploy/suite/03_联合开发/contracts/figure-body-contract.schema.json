{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/figure-body-contract.schema.json",
  "title": "PaperFigure to PaperSpine body integration contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "status", "job_id", "paper_id", "authority", "figures", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "contract_type": {"const": "paperspine.figure.body"},
    "status": {"const": "PASS"},
    "job_id": {"type": "string", "minLength": 1},
    "paper_id": {"type": "string", "minLength": 1},
    "authority": {"type": "object"},
    "figures": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["figure_id", "figure_kind", "figure_role", "publication_role", "editorial_rationale", "claim_coverage", "display_number", "label", "caption", "scientific_question", "claim", "intended_conclusion", "claim_boundary", "results_units", "hero_panel", "panels", "publication_asset", "editable_source", "selection_evidence", "latex", "prose_contract"],
        "properties": {
          "figure_id": {"type": "string", "minLength": 1},
          "figure_kind": {"enum": ["data", "schematic"]},
          "figure_role": {"type": "string", "minLength": 1},
          "publication_role": {"enum": ["main", "supplementary"]},
          "editorial_rationale": {"type": "string", "minLength": 8},
          "claim_coverage": {"type": "object"},
          "display_number": {"type": ["string", "null"]},
          "scientific_identity": {
            "type": "object",
            "required": ["authority_status", "canonical_name", "authority_artifact", "authority_locator", "forbidden_names", "locked_surfaces"],
            "properties": {
              "authority_status": {"const": "verified"},
              "canonical_name": {"type": "string", "minLength": 1},
              "authority_artifact": {"type": "string", "minLength": 1},
              "authority_locator": {"type": "string", "minLength": 1},
              "forbidden_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "locked_surfaces": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {"enum": ["final_pixels", "editable_source", "caption", "body_contract", "lineage_receipt"]}
              }
            },
            "additionalProperties": true
          },
          "identity_audit": {
            "type": "object",
            "required": ["schema_version", "status", "audit_path", "audit_sha256", "reviewer", "producer_identity", "scientific_identity", "surfaces"],
            "properties": {
              "schema_version": {"const": "1.0"},
              "status": {"const": "PASS"},
              "audit_path": {"type": "string", "minLength": 1},
              "audit_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "reviewer": {"type": "object"},
              "producer_identity": {"type": "string", "minLength": 1},
              "scientific_identity": {"type": "object"},
              "surfaces": {"type": "object"}
            },
            "additionalProperties": false
          },
          "placement": {
            "type": "object",
            "required": ["column_span"],
            "properties": {
              "column_span": {"enum": ["one_column", "two_column_span"]}
            },
            "additionalProperties": false
          },
          "final_size_context": {
            "type": "object",
            "required": ["document_layout_mode", "column_span", "physical_width_mm", "render_dpi"],
            "properties": {
              "document_layout_mode": {"enum": ["single_column", "two_column"]},
              "column_span": {"enum": ["one_column", "two_column_span"]},
              "physical_width_mm": {"type": "number", "exclusiveMinimum": 0},
              "render_dpi": {"type": "integer", "minimum": 72}
            },
            "additionalProperties": false
          },
          "label": {"type": "string", "pattern": "^fig:"},
          "caption": {"type": "string", "minLength": 4},
          "scientific_question": {"type": "string", "minLength": 8},
          "claim": {"type": "string", "minLength": 12},
          "intended_conclusion": {"type": "string", "minLength": 12},
          "claim_boundary": {"type": "string", "minLength": 8},
          "results_units": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "hero_panel": {"type": "string", "minLength": 1},
          "panels": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "publication_asset": {
            "type": "object",
            "required": ["path", "format", "sha256", "candidate_id"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "format": {"enum": ["pdf", "svg", "png"]},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
            },
            "additionalProperties": false
          },
          "editable_source": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["path", "format", "sha256"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "format": {"enum": ["svg", "pptx"]},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                },
                "additionalProperties": false
              }
            ]
          },
          "selection_evidence": {
            "type": "object",
            "required": ["authority", "comparison_receipt", "comparison_validation", "fallback_reason", "current_figure_sha256", "source_sha256", "selected_candidate"],
            "properties": {
              "authority": {"type": "string", "minLength": 1},
              "comparison_receipt": {"type": ["string", "null"]},
              "comparison_validation": {"type": ["object", "null"]},
              "fallback_reason": {"type": ["string", "null"]},
              "current_figure_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
              "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "selected_candidate": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
            },
            "additionalProperties": false
          },
          "latex": {
            "type": "object",
            "required": ["insertion_marker", "reference", "display_reference", "includes_file", "environment", "width"],
            "properties": {
              "insertion_marker": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1},
              "display_reference": {"type": "string", "minLength": 1},
              "includes_file": {"type": "string", "minLength": 1},
              "environment": {"enum": ["figure", "figure*"]},
              "width": {"enum": ["\\linewidth", "\\columnwidth", "\\textwidth"]}
            },
            "additionalProperties": false
          },
          "prose_contract": {
            "type": "object",
            "required": ["results_units", "allowed_claim", "intended_conclusion", "claim_boundary", "hero_panel", "evidence_anchors"],
            "properties": {
              "results_units": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "allowed_claim": {"type": "string", "minLength": 12},
              "intended_conclusion": {"type": "string", "minLength": 12},
              "claim_boundary": {"type": "string", "minLength": 8},
              "hero_panel": {"type": "string", "minLength": 1},
              "evidence_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "artifacts": {"type": "object"}
  }
}
