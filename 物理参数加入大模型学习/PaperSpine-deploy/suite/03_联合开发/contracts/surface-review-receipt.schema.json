{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/surface-review-receipt.schema.json",
  "title": "Independent per-page final surface review",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "task_id", "revision_id", "surface_kind", "source_sha256", "prepared_receipt_sha256", "reviewer_id", "producer_ids", "self_signed_final", "final_decision", "reviewed_at", "pages"],
  "properties": {
    "contract": {"const": "paperspine5.surface-review-receipt"},
    "contract_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "surface_kind": {"enum": ["pdf", "word"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prepared_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "producer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "self_signed_final": {"const": false},
    "final_decision": {"enum": ["pass", "blocked"]},
    "reviewed_at": {"type": "string", "minLength": 1},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "render_sha256", "status"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "render_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["pass", "blocked"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
