{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/target-obligation-ledger.schema.json",
  "title": "Evidence-bound target obligation ledger with readiness-layer classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "status",
    "frozen",
    "target_authority_sha256",
    "obligations",
    "external_action_authorized",
    "ledger_sha256"
  ],
  "properties": {
    "contract": {"const": "paperspine5.target-obligation-ledger"},
    "contract_version": {"const": "1.0"},
    "status": {"const": "PASS"},
    "frozen": {"const": true},
    "target_authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["hard", "readiness_scope"],
        "properties": {
          "hard": {"const": true},
          "readiness_scope": {"const": "local_delivery"}
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "authority_rule_id",
          "hard",
          "readiness_scope",
          "authority_binding",
          "evidence_locator"
        ],
        "properties": {
          "obligation_id": {"type": "string", "minLength": 1},
          "authority_rule_id": {"type": "string", "minLength": 1},
          "hard": {"type": "boolean"},
          "readiness_scope": {
            "enum": ["local_delivery", "author_only_submission"]
          },
          "author_fact_key": {
            "enum": [
              "author_identity",
              "affiliation",
              "orcid",
              "funding",
              "conflict_of_interest",
              "data_availability",
              "code_availability",
              "author_contributions",
              "corresponding_author"
            ]
          },
          "authority_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "sha256"],
            "properties": {
              "artifact_id": {"const": "target_authority"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "evidence_locator": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "readiness_scope": {"const": "author_only_submission"}
              },
              "required": ["readiness_scope"]
            },
            "then": {"required": ["author_fact_key"]},
            "else": {"not": {"required": ["author_fact_key"]}}
          }
        ]
      }
    },
    "external_action_authorized": {"const": false},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
