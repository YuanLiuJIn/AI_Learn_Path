{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/task-record.schema.json",
  "title": "PaperSpine5 task registry record",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "task_id", "title", "description", "host", "status", "revision", "active_run_id", "core_root", "workspace_root", "run_root", "material_grants", "product_manifest", "state", "legacy", "migration_status", "job_path", "state_path", "created_at", "updated_at"],
  "properties": {
    "contract": {"const": "paperspine5.task-record"},
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "host": {"enum": ["codex", "claude-code", "dsh", "standalone-skill"]},
    "status": {"enum": ["created", "active", "blocked", "completed", "archived"]},
    "revision": {"type": "integer", "minimum": 0},
    "active_run_id": {"type": "string", "minLength": 1},
    "core_root": {"type": "string", "minLength": 1},
    "workspace_root": {"type": "string", "minLength": 1},
    "run_root": {"type": "string", "minLength": 1},
    "material_grants": {"type": "array", "items": {"$ref": "capability-grant.schema.json"}},
    "product_manifest": {"$ref": "product-manifest.schema.json"},
    "state": {"type": "object"},
    "legacy": {"type": ["object", "null"]},
    "migration_status": {"enum": ["not_applicable", "registered_read_only"]},
    "job_path": {"type": "string", "minLength": 1},
    "state_path": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
