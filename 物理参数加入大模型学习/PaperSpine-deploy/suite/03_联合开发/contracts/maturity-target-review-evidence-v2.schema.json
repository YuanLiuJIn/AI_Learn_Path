{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine5.local/contracts/maturity-target-review-evidence-v2.schema.json",
  "title": "Independent target operator evaluation evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "contract_version", "authority", "producer_identity", "reviewer_identity",
    "producer_process_id", "reviewer_process_id", "subject", "target_template",
    "profile_catalog_sha256", "hard_obligation_ids", "findings",
    "external_action_authorized", "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "paperspine5.maturity-target-review-evidence-v2"},
    "contract_version": {"const": "2.0"},
    "authority": {"const": "paperspine5-host-independent-target-evaluator"},
    "producer_identity": {"type": "string", "minLength": 1},
    "reviewer_identity": {"const": "paperspine5-independent-target-reviewer-v2"},
    "producer_process_id": {"type": "string", "minLength": 1},
    "reviewer_process_id": {"type": "string", "minLength": 1},
    "subject": {"$ref": "#/$defs/subject"},
    "target_template": {"enum": ["oup", "ieee", "generic_latex", "word_heavy"]},
    "profile_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "hard_obligation_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^target-rule:[A-Za-z0-9._-]+$"}
    },
    "findings": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/finding"}
    },
    "external_action_authorized": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "revision_id", "build_id", "material_snapshot_sha256"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "pattern": "^[0-9]+$"},
        "build_id": {"type": "string", "minLength": 1},
        "material_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "tex_source", "bibliography", "pdf", "docx", "artifact_ledger",
            "package_manifest", "render_receipt", "pdf_figure_receipt",
            "fixture_freeze_receipt", "bibliography_source_receipt"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "operator", "artifact_bindings"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "operator": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "artifact_bindings": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/artifactBinding"}
        }
      }
    }
  }
}
