{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine5.local/contracts/contribution-confirmation.schema.json",
  "title": "Issue-bound user confirmation of prepared contribution candidates",
  "description": "J5 phase 2 browser intent. The loopback Product Web server, not the browser or current Agent host, binds the authenticated session identity and confirmed_at when it commits the full decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "confirmation_id", "issue_id", "task_id", "expected_revision", "preparation_sha256", "decisions", "external_action_authorized"],
  "properties": {
    "contract": {"const": "paperspine5.contribution-confirmation"},
    "schema_version": {"const": "1.0"},
    "confirmation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "issue_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "expected_revision": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^[0-9]+$"}]},
    "preparation_sha256": {"$ref": "#/$defs/sha256"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "choice", "reason"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "choice": {"enum": ["accept", "revise", "reject"]},
          "revised_statement": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "external_action_authorized": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
