{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/canonical-artifact-bundle.schema.json",
  "title": "W5 canonical artifact evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "subject", "status", "blockers", "input_artifacts", "figure_intent_receipts", "final_claim_index", "material_coverage", "surface_receipts", "changed_artifact_ids", "invalidated_artifacts", "dependency_graph", "limitations", "external_action_authorized", "bundle_sha256"],
  "properties": {
    "contract": {"const": "paperspine5.canonical-artifact-bundle"},
    "contract_version": {"const": "1.0"},
    "subject": {"type": "object", "required": ["task_id", "revision_id", "input_hashes"]},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "input_artifacts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "figure_intent_receipts": {"type": "array", "items": {"type": "object"}},
    "final_claim_index": {"type": "object"},
    "material_coverage": {
      "type": "object",
      "required": ["contract", "contract_version", "subject", "profile_sha256", "canonical_source_sha256", "primary_manuscript_source_id", "source_word_coverage_ratio", "selected_figure_source_ids", "readiness_contradictions", "status", "external_action_authorized", "receipt_sha256"],
      "properties": {
        "contract": {"const": "paperspine5.material-coverage-receipt"},
        "contract_version": {"const": "1.0"},
        "subject": {"type": "object"},
        "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "primary_manuscript_source_id": {"type": ["string", "null"]},
        "source_word_coverage_ratio": {"type": ["number", "null"], "minimum": 0},
        "selected_figure_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "readiness_contradictions": {"type": "array", "maxItems": 0},
        "status": {"const": "PASS"},
        "external_action_authorized": {"const": false},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "surface_receipts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "changed_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "invalidated_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "dependency_graph": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "external_action_authorized": {"const": false},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
