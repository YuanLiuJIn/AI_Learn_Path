{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine5.local/release/skill-managed-suite-prestate-validation.schema.json",
  "title": "PaperSpine5 standalone Skill managed-suite prestate validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schema_version", "mode", "build_id",
    "content_index_sha256", "target_root", "projection_root",
    "projection_tree", "initial_suite_tree", "initial_classification",
    "runtime_residue", "runtime_residue_summary", "candidate_verified",
    "candidate_eligible", "external_action_authorized", "self_sha256"
  ],
  "properties": {
    "contract": {"const": "paperspine5.skill-managed-suite-prestate-validation"},
    "schema_version": {"const": "1.0"},
    "mode": {"const": "managed-suite"},
    "build_id": {"type": "string", "minLength": 1},
    "content_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_root": {"type": "string", "minLength": 1},
    "projection_root": {"type": "string", "minLength": 1},
    "projection_tree": {"type": "object"},
    "initial_suite_tree": {"type": "object"},
    "initial_classification": {"enum": ["clean", "runtime-residue"]},
    "runtime_residue": {"type": "array"},
    "runtime_residue_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_bytes", "path_digest_sha256"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "path_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate_verified": {"type": "boolean"},
    "candidate_eligible": {"const": true},
    "external_action_authorized": {"const": false},
    "self_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
